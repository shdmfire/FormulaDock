CREATE TABLE formula (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    description TEXT,
    is_builtin INTEGER NOT NULL DEFAULT 0,
    sort_order INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE TABLE formula_symbol (
    id TEXT NOT NULL PRIMARY KEY,
    formula_id TEXT NOT NULL REFERENCES formula(id) ON DELETE CASCADE,

    kind TEXT NOT NULL,
    key TEXT NOT NULL,
    label TEXT NOT NULL,

    default_value TEXT,
    constant_value TEXT,
    expression TEXT,

    unit TEXT,
    precision INTEGER NOT NULL DEFAULT 2,
    required INTEGER NOT NULL DEFAULT 1,
    sort_order INTEGER NOT NULL DEFAULT 0,

    CHECK (kind IN ('INPUT', 'CONSTANT', 'OUTPUT')),

    CHECK (
        (
            kind = 'INPUT'
            AND constant_value IS NULL
            AND expression IS NULL
        )
        OR
        (
            kind = 'CONSTANT'
            AND default_value IS NULL
            AND expression IS NULL
            AND constant_value IS NOT NULL
        )
        OR
        (
            kind = 'OUTPUT'
            AND default_value IS NULL
            AND constant_value IS NULL
            AND expression IS NOT NULL
        )
    )
);

CREATE UNIQUE INDEX formula_symbol_unique_key
ON formula_symbol(formula_id, key);

CREATE INDEX formula_symbol_formula_id_index
ON formula_symbol(formula_id);

CREATE INDEX formula_symbol_formula_kind_index
ON formula_symbol(formula_id, kind);

countFormulas:
SELECT COUNT(*)
FROM formula;

selectAllFormulas:
SELECT *
FROM formula
ORDER BY sort_order ASC, updated_at DESC;

selectFormulaById:
SELECT *
FROM formula
WHERE id = ?;

selectSymbolsByFormulaId:
SELECT *
FROM formula_symbol
WHERE formula_id = ?
ORDER BY
    CASE kind
        WHEN 'INPUT' THEN 0
        WHEN 'CONSTANT' THEN 1
        WHEN 'OUTPUT' THEN 2
        ELSE 3
    END ASC,
    sort_order ASC;

selectInputSymbolsByFormulaId:
SELECT *
FROM formula_symbol
WHERE formula_id = ?
AND kind = 'INPUT'
ORDER BY sort_order ASC;

selectConstantSymbolsByFormulaId:
SELECT *
FROM formula_symbol
WHERE formula_id = ?
AND kind = 'CONSTANT'
ORDER BY sort_order ASC;

selectOutputSymbolsByFormulaId:
SELECT *
FROM formula_symbol
WHERE formula_id = ?
AND kind = 'OUTPUT'
ORDER BY sort_order ASC;

insertFormula:
INSERT INTO formula(
    id,
    title,
    description,
    is_builtin,
    sort_order,
    created_at,
    updated_at
)
VALUES (?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(id) DO UPDATE SET
    title = excluded.title,
    description = excluded.description,
    is_builtin = excluded.is_builtin,
    sort_order = excluded.sort_order,
    updated_at = excluded.updated_at;

insertFormulaSymbol:
INSERT INTO formula_symbol(
    id,
    formula_id,
    kind,
    key,
    label,
    default_value,
    constant_value,
    expression,
    unit,
    precision,
    required,
    sort_order
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteSymbolsByFormulaId:
DELETE FROM formula_symbol
WHERE formula_id = ?;

deleteFormulaById:
DELETE FROM formula
WHERE id = ?;

CREATE TABLE calculation_session (
    id TEXT NOT NULL PRIMARY KEY,
    formula_id TEXT NOT NULL,
    formula_title TEXT NOT NULL,
    formula_description TEXT,
    formula_is_builtin INTEGER NOT NULL DEFAULT 0,
    status TEXT NOT NULL,
    started_at INTEGER NOT NULL,
    last_active_at INTEGER NOT NULL,
    ended_at INTEGER,
    final_revision_id TEXT,
    revision_count INTEGER NOT NULL DEFAULT 0,
    note TEXT,

    CHECK (status IN ('ACTIVE', 'PAUSED', 'CLOSED'))
);

CREATE INDEX calculation_session_formula_id_index
ON calculation_session(formula_id);

CREATE INDEX calculation_session_last_active_at_index
ON calculation_session(last_active_at DESC);

CREATE INDEX calculation_session_status_index
ON calculation_session(status);

CREATE TABLE calculation_history (
    id TEXT NOT NULL PRIMARY KEY,
    session_id TEXT REFERENCES calculation_session(id) ON DELETE CASCADE,
    revision_no INTEGER NOT NULL DEFAULT 1,
    changed_keys TEXT,
    formula_id TEXT NOT NULL,
    formula_title TEXT NOT NULL,
    formula_description TEXT,
    formula_is_builtin INTEGER NOT NULL DEFAULT 0,
    status TEXT NOT NULL,
    error_message TEXT,
    error_field_key TEXT,
    note TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,

    CHECK (status IN ('SUCCESS', 'FAILURE')),
    CHECK (
        (
            status = 'SUCCESS'
            AND error_message IS NULL
            AND error_field_key IS NULL
        )
        OR
        (
            status = 'FAILURE'
            AND error_message IS NOT NULL
        )
    )
);

CREATE INDEX calculation_history_formula_id_index
ON calculation_history(formula_id);

CREATE INDEX calculation_history_session_id_index
ON calculation_history(session_id);

CREATE UNIQUE INDEX calculation_history_session_revision_index
ON calculation_history(session_id, revision_no);

CREATE INDEX calculation_history_created_at_index
ON calculation_history(created_at DESC);

CREATE INDEX calculation_history_status_index
ON calculation_history(status);

CREATE TABLE calculation_history_input (
    id TEXT NOT NULL PRIMARY KEY,
    history_id TEXT NOT NULL REFERENCES calculation_history(id) ON DELETE CASCADE,
    key TEXT NOT NULL,
    label TEXT NOT NULL,
    raw_value TEXT,
    numeric_value REAL,
    unit TEXT,
    required INTEGER NOT NULL DEFAULT 1,
    sort_order INTEGER NOT NULL DEFAULT 0
);

CREATE UNIQUE INDEX calculation_history_input_unique_key
ON calculation_history_input(history_id, key);

CREATE INDEX calculation_history_input_history_id_index
ON calculation_history_input(history_id);

CREATE TABLE calculation_history_output (
    id TEXT NOT NULL PRIMARY KEY,
    history_id TEXT NOT NULL REFERENCES calculation_history(id) ON DELETE CASCADE,
    key TEXT NOT NULL,
    label TEXT NOT NULL,
    expression TEXT NOT NULL,
    value REAL NOT NULL,
    formatted_value TEXT NOT NULL,
    unit TEXT,
    precision INTEGER NOT NULL DEFAULT 2,
    sort_order INTEGER NOT NULL DEFAULT 0
);

CREATE UNIQUE INDEX calculation_history_output_unique_key
ON calculation_history_output(history_id, key);

CREATE INDEX calculation_history_output_history_id_index
ON calculation_history_output(history_id);

countCalculationHistories:
SELECT COUNT(*)
FROM calculation_session
WHERE status = 'CLOSED';

selectCalculationHistories:
SELECT *
FROM calculation_session
WHERE status = 'CLOSED'
ORDER BY last_active_at DESC
LIMIT ? OFFSET ?;

selectCalculationHistoriesByFormulaId:
SELECT *
FROM calculation_session
WHERE formula_id = ? AND status = 'CLOSED'
ORDER BY last_active_at DESC
LIMIT ? OFFSET ?;

selectCalculationHistoryById:
SELECT *
FROM calculation_session
WHERE id = ?;

selectResumableCalculationSession:
SELECT *
FROM calculation_session
WHERE formula_id = ?
  AND status IN ('ACTIVE', 'PAUSED')
  AND last_active_at >= ?
ORDER BY last_active_at DESC
LIMIT 1;

selectCalculationRevisionById:
SELECT *
FROM calculation_history
WHERE id = ?;

selectCalculationRevisionsBySessionId:
SELECT *
FROM calculation_history
WHERE session_id = ?
ORDER BY revision_no DESC;

selectLatestCalculationRevision:
SELECT *
FROM calculation_history
WHERE session_id = ?
ORDER BY revision_no DESC
LIMIT 1;

selectCalculationHistoryInputs:
SELECT *
FROM calculation_history_input
WHERE history_id = ?
ORDER BY sort_order ASC;

selectCalculationHistoryOutputs:
SELECT *
FROM calculation_history_output
WHERE history_id = ?
ORDER BY sort_order ASC;

insertCalculationSession:
INSERT INTO calculation_session(
    id,
    formula_id,
    formula_title,
    formula_description,
    formula_is_builtin,
    status,
    started_at,
    last_active_at,
    ended_at,
    final_revision_id,
    revision_count,
    note
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(id) DO UPDATE SET
    status = excluded.status,
    last_active_at = excluded.last_active_at,
    ended_at = excluded.ended_at,
    final_revision_id = excluded.final_revision_id,
    revision_count = excluded.revision_count,
    note = excluded.note;

insertCalculationHistory:
INSERT INTO calculation_history(
    id,
    session_id,
    revision_no,
    changed_keys,
    formula_id,
    formula_title,
    formula_description,
    formula_is_builtin,
    status,
    error_message,
    error_field_key,
    note,
    created_at,
    updated_at
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(id) DO UPDATE SET
    session_id = excluded.session_id,
    revision_no = excluded.revision_no,
    changed_keys = excluded.changed_keys,
    formula_id = excluded.formula_id,
    formula_title = excluded.formula_title,
    formula_description = excluded.formula_description,
    formula_is_builtin = excluded.formula_is_builtin,
    status = excluded.status,
    error_message = excluded.error_message,
    error_field_key = excluded.error_field_key,
    note = excluded.note,
    updated_at = excluded.updated_at;

insertCalculationHistoryInput:
INSERT INTO calculation_history_input(
    id,
    history_id,
    key,
    label,
    raw_value,
    numeric_value,
    unit,
    required,
    sort_order
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

insertCalculationHistoryOutput:
INSERT INTO calculation_history_output(
    id,
    history_id,
    key,
    label,
    expression,
    value,
    formatted_value,
    unit,
    precision,
    sort_order
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateCalculationHistoryNote:
UPDATE calculation_session
SET note = ?, last_active_at = ?
WHERE id = ?;

updateCalculationSessionAfterRevision:
UPDATE calculation_session
SET final_revision_id = ?, revision_count = ?, last_active_at = ?, status = 'ACTIVE'
WHERE id = ?;

activateCalculationSession:
UPDATE calculation_session
SET status = 'ACTIVE', last_active_at = ?
WHERE id = ? AND status != 'CLOSED';

pauseCalculationSession:
UPDATE calculation_session
SET status = 'PAUSED', last_active_at = ?
WHERE id = ? AND status != 'CLOSED';

closeCalculationSession:
UPDATE calculation_session
SET status = 'CLOSED', last_active_at = ?, ended_at = ?
WHERE id = ?;

closeExpiredCalculationSessions:
UPDATE calculation_session
SET status = 'CLOSED', ended_at = last_active_at
WHERE status IN ('ACTIVE', 'PAUSED') AND last_active_at < ?;

deleteCalculationHistoryInputs:
DELETE FROM calculation_history_input
WHERE history_id = ?;

deleteCalculationHistoryOutputs:
DELETE FROM calculation_history_output
WHERE history_id = ?;

deleteCalculationHistoryById:
DELETE FROM calculation_session
WHERE id = ?;

deleteAllCalculationHistories:
DELETE FROM calculation_session;
